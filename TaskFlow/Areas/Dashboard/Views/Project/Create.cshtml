@model ProjectCreateVM
@{
    ViewData["Title"] = DashboardResource.AddProject;
}
<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
            <h5 class="mb-0">@DashboardResource.AddProject</h5>
        </div>
        <div class="card-body">
            <form asp-area="Dashboard" asp-controller="Project" asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Color" class="form-label"></label>
                        <input asp-for="Color" class="form-control" type="color" />
                        <span asp-validation-for="Color" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary swal-save-button">
                        <i class="bi bi-check2"></i> @DashboardResource.Save
                    </button>
                    <a asp-area="Dashboard" asp-controller="Project" asp-action="Index" class="btn btn-outline-secondary ms-2">@DashboardResource.Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const swalTexts = {
            confirmSaveTitle: '@Html.Raw(Json.Serialize(DashboardResource.Confirminsert))',
            confirmSaveText: '@Html.Raw(Json.Serialize(DashboardResource.insertItem))',
            yesSave: '@Html.Raw(Json.Serialize(DashboardResource.Yes))',
            cancel: '@Html.Raw(Json.Serialize(DashboardResource.Cancel))'
        };
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.querySelector('.swal-save-button');
            if (!btn) return;
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const form = this.closest('form');
                Swal.fire({
                    title: swalTexts.confirmSaveTitle,
                    text: swalTexts.confirmSaveText,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0d6efd',
                    cancelButtonColor: '#d33',
                    confirmButtonText: swalTexts.yesSave,
                    cancelButtonText: swalTexts.cancel
                }).then(r => { if (r.isConfirmed) form.submit(); });
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
