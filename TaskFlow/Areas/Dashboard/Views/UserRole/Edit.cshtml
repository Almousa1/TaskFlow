@model UserRoleEditVM
@{
    ViewData["Title"] = DashboardResource.EditRole;
}
<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
            <h5 class="mb-0">@DashboardResource.EditRole</h5>
        </div>
        <div class="card-body">
            <form asp-area="Dashboard" asp-controller="UserRole" asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Guid" />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="RoleName" class="form-label"></label>
                        <input asp-for="RoleName" class="form-control" />
                        <span asp-validation-for="RoleName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="RoleNameAr" class="form-label"></label>
                        <input asp-for="RoleNameAr" class="form-control" />
                        <span asp-validation-for="RoleNameAr" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="IsActive" class="form-label"></label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="true">@DashboardResource.Active</option>
                        <option value="false">@DashboardResource.Inactive</option>
                    </select>
                    <span asp-validation-for="IsActive" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2"></i> @DashboardResource.Save
                    </button>
                    <a asp-area="Dashboard" asp-controller="UserRole" asp-action="Index" class="btn btn-outline-secondary ms-2">@DashboardResource.Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}