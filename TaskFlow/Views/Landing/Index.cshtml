@using System.Globalization
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRTL = culture == "ar";
}
<!DOCTYPE html>
<html lang="@culture" dir="@(isRTL ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TaskFlow - Manage Your Tasks</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Poppins', sans-serif;
            overflow-x: hidden;
            color: #1e293b;
        }
        .navbar {
            padding: 1rem 0;
            background: rgba(255,255,255,0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(0,0,0,0.06);
            transition: all 0.3s;
        }
        .navbar .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            color: #0f7179 !important;
        }
        .navbar .navbar-brand i { margin-inline-end: 8px; }
        .navbar .nav-link {
            font-weight: 500;
            color: #475569 !important;
            padding: 0.5rem 1.2rem !important;
            transition: color 0.2s;
        }
        .navbar .nav-link:hover { color: #0f7179 !important; }
        .btn-flow {
            background: linear-gradient(135deg, #0f7179, #0b4d52);
            color: #fff;
            border: none;
            padding: 0.6rem 1.8rem;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s;
        }
        .btn-flow:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(15,113,121,0.3);
            color: #fff;
        }
        .btn-flow-outline {
            background: transparent;
            color: #0f7179;
            border: 2px solid #0f7179;
            padding: 0.6rem 1.8rem;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s;
        }
        .btn-flow-outline:hover {
            background: #0f7179;
            color: #fff;
        }
        .hero {
            min-height: 92vh;
            display: flex;
            align-items: center;
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 50%, #f0fdf4 100%);
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            @(isRTL ? "left" : "right"): -20%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(15,113,121,0.08) 0%, transparent 70%);
            border-radius: 50%;
        }
        .hero::after {
            content: '';
            position: absolute;
            bottom: -30%;
            @(isRTL ? "right" : "left"): -10%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(15,113,121,0.06) 0%, transparent 70%);
            border-radius: 50%;
        }
        .hero-content { position: relative; z-index: 1; }
        .hero h1 {
            font-size: 3.5rem;
            font-weight: 800;
            line-height: 1.15;
            margin-bottom: 1.2rem;
        }
        .hero h1 span {
            background: linear-gradient(135deg, #0f7179, #14b8a6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero p {
            font-size: 1.15rem;
            color: #64748b;
            max-width: 540px;
            line-height: 1.7;
            margin-bottom: 2rem;
        }
        .hero .cta-group { display: flex; gap: 1rem; flex-wrap: wrap; }
        .hero-image {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .hero-image .mockup {
            width: 100%;
            max-width: 500px;
            border-radius: 20px;
            box-shadow: 0 30px 80px rgba(0,0,0,0.1);
            background: #fff;
            padding: 2rem;
            position: relative;
        }
        .hero-image .mockup .dots {
            display: flex;
            gap: 8px;
            margin-bottom: 1.5rem;
        }
        .hero-image .mockup .dots span {
            width: 12px; height: 12px; border-radius: 50%;
        }
        .hero-image .mockup .dots span:nth-child(1) { background: #ef4444; }
        .hero-image .mockup .dots span:nth-child(2) { background: #f59e0b; }
        .hero-image .mockup .dots span:nth-child(3) { background: #22c55e; }
        .hero-image .mockup .task-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            background: #f8fafc;
            border-radius: 12px;
            margin-bottom: 10px;
            border: 1px solid #e2e8f0;
        }
        .hero-image .mockup .task-item .check {
            width: 22px; height: 22px;
            border-radius: 6px;
            border: 2px solid #cbd5e1;
            flex-shrink: 0;
        }
        .hero-image .mockup .task-item .check.done {
            background: #0f7179;
            border-color: #0f7179;
            position: relative;
        }
        .hero-image .mockup .task-item .check.done::after {
            content: '✓';
            color: #fff;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 18px;
        }
        .hero-image .mockup .task-item .info { flex: 1; }
        .hero-image .mockup .task-item .info .title {
            font-weight: 600;
            font-size: 0.9rem;
        }
        .hero-image .mockup .task-item .info .sub {
            font-size: 0.75rem;
            color: #94a3b8;
        }
        .hero-image .mockup .task-item .badge-flow {
            font-size: 0.7rem;
            padding: 4px 10px;
            border-radius: 50px;
            font-weight: 600;
        }
        .hero-image .mockup .task-item .badge-flow.high { background: #fef2f2; color: #ef4444; }
        .hero-image .mockup .task-item .badge-flow.medium { background: #fffbeb; color: #f59e0b; }
        .hero-image .mockup .task-item .badge-flow.low { background: #f0fdf4; color: #22c55e; }
        .section-title {
            text-align: center;
            margin-bottom: 3.5rem;
        }
        .section-title h2 {
            font-weight: 700;
            font-size: 2.2rem;
            margin-bottom: 0.8rem;
        }
        .section-title p {
            color: #64748b;
            max-width: 500px;
            margin: 0 auto;
        }
        .features {
            padding: 6rem 0;
            background: #fff;
        }
        .feature-card {
            padding: 2.5rem 2rem;
            border-radius: 20px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            transition: all 0.3s;
            height: 100%;
        }
        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.06);
            border-color: #0f7179;
        }
        .feature-card .icon {
            width: 60px; height: 60px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1.2rem;
            background: linear-gradient(135deg, #0f7179, #14b8a6);
            color: #fff;
        }
        .feature-card h5 {
            font-weight: 600;
            margin-bottom: 0.8rem;
        }
        .feature-card p {
            color: #64748b;
            font-size: 0.95rem;
            margin-bottom: 0;
        }
        .stats {
            padding: 5rem 0;
            background: linear-gradient(135deg, #0f7179, #0b4d52);
            color: #fff;
        }
        .stats .stat-item { text-align: center; }
        .stats .stat-item h3 { font-size: 2.8rem; font-weight: 800; margin-bottom: 0.3rem; }
        .stats .stat-item p { opacity: 0.85; margin-bottom: 0; font-size: 1rem; }
        .cta {
            padding: 6rem 0;
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        }
        .cta-card {
            background: linear-gradient(135deg, #0f7179, #0b4d52);
            border-radius: 30px;
            padding: 4rem 3rem;
            color: #fff;
            text-align: center;
        }
        .cta-card h2 { font-weight: 700; font-size: 2.2rem; margin-bottom: 1rem; }
        .cta-card p { opacity: 0.9; max-width: 500px; margin: 0 auto 2rem; }
        .cta-card .btn-flow {
            background: #fff;
            color: #0f7179;
            padding: 0.8rem 2.5rem;
        }
        .cta-card .btn-flow:hover {
            background: #f1f5f9;
            color: #0f7179;
        }
        footer {
            padding: 2rem 0;
            background: #1e293b;
            color: #94a3b8;
        }
        footer a { color: #cbd5e1; text-decoration: none; }
        footer a:hover { color: #fff; }
        @@media (max-width: 992px) {
            .hero { min-height: auto; padding: 6rem 0 4rem; text-align: center; }
            .hero h1 { font-size: 2.5rem; }
            .hero p { margin: 0 auto 2rem; }
            .hero .cta-group { justify-content: center; }
            .hero-image { margin-top: 3rem; }
            .hero-image .mockup { max-width: 100%; }
        }
        @@media (max-width: 576px) {
            .hero h1 { font-size: 2rem; }
            .section-title h2 { font-size: 1.7rem; }
            .cta-card { padding: 3rem 1.5rem; }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-check2-square"></i> TaskFlow
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" href="#features">@(isRTL ? "المميزات" : "Features")</a></li>
                    <li class="nav-item"><a class="nav-link" href="#cta">@(isRTL ? "ابدأ الآن" : "Get Started")</a></li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-flow-outline btn-sm" asp-area="Auth" asp-controller="Login" asp-action="Index">
                            @(isRTL ? "تسجيل الدخول" : "Sign In")
                        </a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-flow btn-sm" asp-area="Auth" asp-controller="SignUp" asp-action="Index">
                            @(isRTL ? "إنشاء حساب" : "Sign Up")
                        </a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a asp-controller="Language" asp-action="Set"
                           asp-route-culture="@(isRTL ? "en" : "ar")"
                           asp-route-returnUrl="@Context.Request.Path"
                           class="btn btn-sm btn-outline-secondary border-0" style="color:#475569;">
                            <i class="bi bi-translate"></i> @(isRTL ? "English" : "العربية")
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <section class="hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 hero-content">
                    <h1>
                        @(isRTL ? "نظّم مهامك" : "Organize Your")<br />
                        <span>@(isRTL ? "بذكاء وسهولة" : "Tasks &amp; Projects")</span>
                    </h1>
                    <p>
                        @(isRTL
                            ? "TaskFlow هي منصة ذكية لإدارة المهام والمشاريع. نظّم أعمالك، تابع التقدم، وحقق أهدافك بكفاءة."
                            : "TaskFlow is a smart platform for managing tasks and projects. Organize your work, track progress, and achieve your goals efficiently.")
                    </p>
                    <div class="cta-group">
                        <a class="btn btn-flow" asp-area="Auth" asp-controller="SignUp" asp-action="Index">
                            @(isRTL ? "ابدأ مجاناً" : "Get Started Free")
                            <i class="bi bi-arrow-@(isRTL ? "left" : "right") ms-1"></i>
                        </a>
                        <a class="btn btn-flow-outline" href="#features">
                            @(isRTL ? "اعرف المزيد" : "Learn More")
                        </a>
                    </div>
                </div>
                <div class="col-lg-6 hero-image">
                    <div class="mockup">
                        <div class="dots">
                            <span></span><span></span><span></span>
                        </div>
                        <div class="task-item">
                            <div class="check done"></div>
                            <div class="info">
                                <div class="title">@(isRTL ? "تصميم واجهة المستخدم" : "Design Landing Page")</div>
                                <div class="sub">@(isRTL ? "المشروع: الموقع الرسمي" : "Project: Company Website")</div>
                            </div>
                            <span class="badge-flow high">@(isRTL ? "عالية" : "High")</span>
                        </div>
                        <div class="task-item">
                            <div class="check"></div>
                            <div class="info">
                                <div class="title">@(isRTL ? "مراجعة الكود" : "Review Backend Code")</div>
                                <div class="sub">@(isRTL ? "المشروع: تطبيق المهام" : "Project: Task App")</div>
                            </div>
                            <span class="badge-flow medium">@(isRTL ? "متوسطة" : "Medium")</span>
                        </div>
                        <div class="task-item">
                            <div class="check"></div>
                            <div class="info">
                                <div class="title">@(isRTL ? "كتابة التقارير" : "Write Documentation")</div>
                                <div class="sub">@(isRTL ? "المشروع: النظام الداخلي" : "Project: Internal System")</div>
                            </div>
                            <span class="badge-flow low">@(isRTL ? "منخفضة" : "Low")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="features" id="features">
        <div class="container">
            <div class="section-title">
                <h2>@(isRTL ? "مميزات قوية" : "Powerful Features")</h2>
                <p>@(isRTL ? "كل ما تحتاجه لإدارة مهامك بكفاءة في مكان واحد" : "Everything you need to manage your tasks efficiently in one place")</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="icon"><i class="bi bi-list-check"></i></div>
                        <h5>@(isRTL ? "إدارة المهام" : "Task Management")</h5>
                        <p>@(isRTL ? "أنشئ ونظّم مهامك بسهولة مع إمكانية تحديد الأولويات والمواعيد النهائية" : "Create and organize your tasks easily with priority and deadline settings")</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="icon"><i class="bi bi-folder"></i></div>
                        <h5>@(isRTL ? "المشاريع" : "Projects")</h5>
                        <p>@(isRTL ? "جمّع مهامك ضمن مشاريع منظمة لتتبع التقدم وإدارة العمل بكفاءة" : "Group your tasks into organized projects to track progress and manage work")</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="icon"><i class="bi bi-tags"></i></div>
                        <h5>@(isRTL ? "التصنيفات" : "Categories")</h5>
                        <p>@(isRTL ? "صنّف مهامك باستخدام تصنيفات مخصصة ملونة للتنظيم السريع" : "Categorize your tasks using custom colored tags for quick organization")</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="icon"><i class="bi bi-graph-up-arrow"></i></div>
                        <h5>@(isRTL ? "لوحة الإحصائيات" : "Dashboard Analytics")</h5>
                        <p>@(isRTL ? "تابع أدائك من خلال إحصائيات شاملة عن المهام المنجزة والمعلقة" : "Track your performance with comprehensive stats on completed and pending tasks")</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="icon"><i class="bi bi-search"></i></div>
                        <h5>@(isRTL ? "بحث متقدم" : "Advanced Search")</h5>
                        <p>@(isRTL ? "ابحث عن أي مهمة بسرعة باستخدام فلتر متعدد المعايير" : "Find any task quickly using multi-criteria filtering")</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="icon"><i class="bi bi-translate"></i></div>
                        <h5>@(isRTL ? "دعم اللغة العربية" : "Arabic Support")</h5>
                        <p>@(isRTL ? "واجهة كاملة باللغة العربية مع دعم الاتجاه من اليمين لليسار" : "Full Arabic interface with RTL support")</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="stats">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4 stat-item">
                    <h3 id="statTasks">10K+</h3>
                    <p>@(isRTL ? "مهمة منجزة" : "Tasks Completed")</p>
                </div>
                <div class="col-md-4 stat-item">
                    <h3 id="statUsers">500+</h3>
                    <p>@(isRTL ? "مستخدم نشط" : "Active Users")</p>
                </div>
                <div class="col-md-4 stat-item">
                    <h3 id="statProjects">1K+</h3>
                    <p>@(isRTL ? "مشروع مكتمل" : "Projects Done")</p>
                </div>
            </div>
        </div>
    </section>

    <section class="cta" id="cta">
        <div class="container">
            <div class="cta-card">
                <h2>@(isRTL ? "ابدأ رحلة الإنتاجية الآن" : "Start Your Productivity Journey")</h2>
                <p>@(isRTL ? "انضم إلى المستخدمين الذين ينظمون مهامهم بكفاءة. ابدأ مجاناً ولا حاجة لبطاقة ائتمان" : "Join users who organize their tasks efficiently. Start for free, no credit card required")</p>
                <a class="btn btn-flow btn-lg" asp-area="Auth" asp-controller="SignUp" asp-action="Index">
                    @(isRTL ? "إنشاء حساب مجاني" : "Create Free Account")
                    <i class="bi bi-arrow-@(isRTL ? "left" : "right") ms-1"></i>
                </a>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-md-0">&copy; @DateTime.Now.Year TaskFlow. @(isRTL ? "جميع الحقوق محفوظة" : "All rights reserved")</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-area="Auth" asp-controller="Login" asp-action="Index" class="me-3">@(isRTL ? "تسجيل الدخول" : "Sign In")</a>
                    <a asp-area="Auth" asp-controller="SignUp" asp-action="Index">@(isRTL ? "إنشاء حساب" : "Sign Up")</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>