@using System.Globalization
@using System.Security.Claims
@{
    var isRTL = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isAuth = User?.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="@lang" dir="@(isRTL ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TaskFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/taskflow.css" />
    @RenderSection("Styles", required: false)
</head>
<body style="background:var(--tf-base-50);">
    <header>
        <nav class="nav-tf navbar navbar-expand-sm">
            <div class="container-fluid">
                <a class="brand-tf" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-check2-square"></i> TaskFlow
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" style="border:none;">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"
                               style="color:var(--tf-base-500);font-weight:500;font-size:var(--tf-fs-sm);">@(isRTL ? "الرئيسية" : "Home")</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2">
                        <li class="nav-item">
                            <a asp-controller="Language" asp-action="Set"
                               asp-route-culture="@(isRTL ? "en" : "ar")"
                               asp-route-returnUrl="@Context.Request.Path"
                               class="btn-tf btn-tf-ghost" style="padding:0.3rem 0.6rem;font-size:var(--tf-fs-xs);">
                                <i class="bi bi-translate"></i> @(isRTL ? "EN" : "AR")
                            </a>
                        </li>
                        @if (isAuth)
                        {
                            <li><a class="btn-tf btn-tf-ghost" asp-area="Auth" asp-controller="Login" asp-action="Logout"><i class="bi bi-box-arrow-left"></i> @(isRTL ? "خروج" : "Logout")</a></li>
                        }
                        else
                        {
                            <li><a class="btn-tf btn-tf-primary" asp-area="Auth" asp-controller="Login" asp-action="Index">@(isRTL ? "دخول" : "Login")</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="flex-fill">@RenderBody()</main>
    <footer style="text-align:center;padding:var(--tf-space-6);color:var(--tf-base-400);font-size:var(--tf-fs-xs);border-top:1px solid var(--tf-base-200);">
        &copy; @DateTime.Now.Year TaskFlow
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
